<link rel="krui-preset" href="krui://preset/unstyled" />
<link rel="stylesheet" href="tailwind_v4.css" />

<div id="tw-root" class="min-h-screen w-full bg-[#0f172a] text-slate-100 p-6 flex flex-col gap-6">
    <!-- 상단 헤더: in oklab 선형 그라데이션 + 5단 box-shadow + popover 트리거 -->
    <div id="tw-banner" class="w-full p-6 rounded-2xl bg-linear-to-r from-indigo-500 to-cyan-400 ring-2 ring-indigo-500 shadow-lg flex items-center justify-between">
        <div class="flex flex-col gap-3">
            <h1 class="text-2xl font-bold text-slate-100">Tailwind CSS v4 순수 드롭인 대시보드</h1>
            <p class="text-sm text-slate-100">무수정 유틸리티 CSS + wgpu 0-relayout 컴포지터 파이프라인</p>
        </div>
        <div class="flex items-center gap-3">
            <button id="open-popover-btn" popovertarget="filter-popover" class="px-4 py-2 rounded-full bg-[#1e293b] text-slate-100 border border-slate-700 transition hover:-translate-y-0.5 hover:bg-indigo-500">
                필터 팝오버
            </button>
            <button id="open-dialog-btn" onclick="{open_dialog_cmd}" class="px-4 py-2 rounded-full bg-indigo-600 text-slate-100 ring-2 ring-indigo-500 shadow-lg transition hover:-translate-y-0.5 hover:scale-102">
                설정 다이얼로그
            </button>
        </div>
    </div>

    <!-- 한국어 IME 입력 + peer-checked 순수 CSS 스위치 -->
    <div class="grid grid-cols-2 gap-6 w-full">
        <div class="p-6 rounded-2xl bg-[#1e293b] border border-slate-700 shadow-lg flex flex-col gap-4">
            <h2 class="text-base font-bold text-slate-100">검색 및 한국어 IME 입력</h2>
            <input id="tw-search" type="text" placeholder="검색어를 입력하세요 (한글 IME 조합 지원)..." bind:value="{search_query}" class="w-full h-10 px-3 rounded-xl bg-slate-900 border border-slate-700 text-slate-100 text-sm" />
            <p id="tw-search-echo" class="text-sm text-slate-300">현재 검색어: {search_query}</p>

            <!-- peer-checked: 순수 HTML+CSS만으로 스위치 이동 및 카드 링 하이라이트 -->
            <div class="p-4 rounded-xl bg-slate-900 border border-slate-700 flex items-center justify-between">
                <input id="peer-toggle" type="checkbox" class="peer appearance-none w-12 h-7 rounded-full bg-slate-700 cursor-pointer" />
                <div id="peer-track" class="w-12 h-7 rounded-full bg-slate-700 ring-2 ring-indigo-500 peer-checked:ring-indigo-500 peer-checked:bg-emerald-500 transition flex items-center px-3">
                    <div id="peer-knob" class="w-5 h-5 rounded-full bg-white transition peer-checked:translate-x-5"></div>
                </div>
                <span class="text-sm text-slate-100 peer-checked:text-cyan-400">실시간 GPU 고속 모드 (`peer-checked`)</span>
            </div>
        </div>

        <!-- group-hover 인터랙션 카드 + :has(> input:checked) 체크 카드 -->
        <div id="group-card" class="group p-6 rounded-2xl bg-[#1e293b] border border-slate-700 ring-2 ring-indigo-500 shadow-lg transition hover:-translate-y-0.5 flex flex-col gap-4">
            <div class="flex items-center justify-between">
                <h2 id="group-title" class="text-base font-bold text-slate-100 transition group-hover:text-cyan-400">Group Hover 연동 카드</h2>
                <div id="group-badge" class="px-3 py-2 rounded-full bg-indigo-600 text-slate-100 text-sm transition group-hover:scale-105 group-hover:rotate-2">
                    v4 Ready
                </div>
            </div>
            <label class="p-4 rounded-xl bg-slate-900 border border-slate-700 flex items-center gap-3 cursor-pointer has-[>input:checked]:bg-indigo-600">
                <input id="has-check" type="checkbox" />
                <span class="text-sm text-slate-100">`:has(&gt; input:checked)` 카드 강조</span>
            </label>
            <details class="p-3 rounded-xl bg-slate-900 border border-slate-700">
                <summary class="text-sm font-bold text-slate-100 cursor-pointer">네이티브 `&lt;details&gt;` 아코디언</summary>
                <p class="text-sm text-slate-300 py-2">JS 없이 순수 HTML/CSS만으로 접고 펼칩니다.</p>
            </details>
        </div>
    </div>

    <div id="filter-popover" popover class="tw-popover flex flex-col gap-3">
        <p class="text-base font-bold text-slate-100">Top-Layer Popover 필터</p>
        <p class="text-sm text-slate-300">바깥 영역 클릭 또는 ESC 키로 닫힙니다.</p>
    </div>

    <dialog id="settings-dialog" open="{dialog_open}" class="p-6 flex flex-col gap-4">
        <h3 class="text-base font-bold text-slate-100">Tailwind v4 Top-Layer 다이얼로그</h3>
        <p class="text-sm text-slate-300">::backdrop 스크림과 함께 최상단 레이어에서 렌더링됩니다.</p>
        <div class="flex justify-end gap-3">
            <button id="close-dialog-btn" onclick="{close_dialog_cmd}" class="px-4 py-2 rounded-full bg-indigo-600 text-slate-100">
                닫기
            </button>
        </div>
    </dialog>
</div>
