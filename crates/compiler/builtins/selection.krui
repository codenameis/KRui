<style>
.krui-ui-check-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10px;
}
.krui-ui-check-labels {
    display: flex;
    flex-direction: column;
    gap: 2px;
}
.krui-ui-field-lbl {
    font-size: 13px;
    font-weight: 600;
    color: var(--krui-text);
}
.krui-ui-field-sub {
    font-size: 11px;
    color: var(--krui-text-muted);
}

.krui-ui-switch-btn {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-width: 0px;
    gap: 12px;
    padding: 6px 10px;
    border-radius: var(--krui-radius);
    background-color: transparent;
    color: var(--krui-text);
    border: 0px solid transparent;
}
.krui-ui-switch-track {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    pointer-events: none;
    width: 52px;
    height: 30px;
    padding: 2px;
    border-radius: var(--krui-pill-radius);
    background-color: var(--krui-input-bg);
    border: 2px solid var(--krui-border);
    transition: background-color 200ms cubic-bezier(0.2, 0, 0, 1), border-color 200ms cubic-bezier(0.2, 0, 0, 1);
}
.krui-ui-switch-track-true {
    background-color: var(--krui-accent);
    border-color: transparent;
}
.krui-ui-switch-thumb {
    flex-shrink: 0;
    pointer-events: none;
    width: 22px;
    height: 22px;
    border-radius: var(--krui-pill-radius);
    background-color: var(--krui-text-secondary);
    transform: translateX(0px);
    transition: background-color 180ms cubic-bezier(0.2, 0, 0, 1), transform 280ms cubic-bezier(0.34, 1.25, 0.64, 1);
}
.krui-ui-switch-thumb-true {
    background-color: var(--krui-accent-fg);
    transform: translateX(22px);
}

.krui-ui-slider-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
}
.krui-ui-slider-head {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
}

.krui-ui-chip {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 6px;
    border-radius: var(--krui-chip-radius);
    background-color: var(--krui-surface);
    border: 1px solid var(--krui-border);
    padding: 3px 6px;
    transition: background-color 180ms cubic-bezier(0.2, 0, 0, 1), border-color 180ms cubic-bezier(0.2, 0, 0, 1);
}
.krui-ui-chip-btn {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 6px;
    padding: 4px 8px;
    border: 0px solid transparent;
    border-radius: 0px;
    background-color: transparent;
    color: var(--krui-text);
    font-size: 12px;
    font-weight: 600;
}
.krui-ui-chip.krui-ui-selected-true {
    background-color: var(--krui-secondary-bg);
    border-color: transparent;
}
.krui-ui-chip-remove {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    color: var(--krui-text-muted);
    border: 0px solid transparent;
    border-radius: var(--krui-pill-radius);
    padding: 4px;
    font-size: 12px;
}
.krui-ui-inline-svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
}

.krui-ui-select-field {
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.krui-ui-picker-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-width: 0px;
    gap: 6px;
    padding: 12px;
    border-radius: var(--krui-dialog-radius);
    background-color: var(--krui-card);
    border: 0px solid transparent;
    box-shadow: var(--krui-shadow);
}
.krui-ui-picker-step {
    min-height: 26px;
    padding: 3px 10px;
}
.krui-ui-picker-head {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
}
.krui-ui-picker-title {
    font-size: 13px;
    font-weight: 700;
    color: var(--krui-heading-color);
}
.krui-ui-cal-grid {
    display: grid;
    grid-template-columns: 34px 34px 34px 34px 34px 34px 34px;
    gap: 3px;
}
.krui-ui-cal-weekday {
    text-align: center;
    font-size: 11px;
    color: var(--krui-text-muted);
    padding: 2px 0px;
}
.krui-ui-time-readout {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 10px;
}
.krui-ui-time-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 4px 10px;
    border-radius: var(--krui-radius);
    background-color: var(--krui-surface);
    border: 1px solid var(--krui-border);
}
.krui-ui-time-digits {
    font-size: 18px;
    font-weight: 700;
    color: var(--krui-heading-color);
}
</style>

<template name="CheckboxField" label="" supporting="" checked="" bind_checked="" onchange="" disabled="{false}" id="" class="" title="">
    <label id="{id}" class="krui-ui-check-row {class}" title="{title}">
        <input type="checkbox" checked="{checked}" bind:checked="{bind_checked}" disabled="{disabled}" onchange="{onchange}" />
        <div class="krui-ui-check-labels">
            <span class="krui-ui-field-lbl">{label}<slot/></span>
            <if test="{supporting != ''}"><span class="krui-ui-field-sub">{supporting}</span></if>
        </div>
    </label>
</template>

<template name="RadioField" label="" group="radio" value="" checked="" bind_checked="" onchange="" disabled="{false}" id="" input_id="" class="" title="">
    <label id="{id}" class="krui-ui-check-row {class}" title="{title}">
        <input id="{input_id}" type="radio" name="{group}" value="{value}" checked="{checked}" bind:checked="{bind_checked}" disabled="{disabled}" onchange="{onchange}" />
        <span class="krui-ui-field-lbl">{label}<slot/></span>
    </label>
</template>

<template name="Switch" label="" checked="{false}" disabled="{false}" onclick="" id="" thumb_id="" class="" title="">
    <button type="button" id="{id}" class="krui-ui-switch-btn {class}" aria-label="{label}" title="{title}" disabled="{disabled}" onclick="{onclick}">
        <span class="krui-ui-field-lbl">{label}<slot/></span>
        <span class="krui-ui-switch-track krui-ui-switch-track-{checked}">
            <span id="{thumb_id}" class="krui-ui-switch-thumb krui-ui-switch-thumb-{checked}"></span>
        </span>
    </button>
</template>

<template name="SliderField" label="" value_text="" min="0" max="100" step="1" value="" bind_value="" oninput="" onchange="" disabled="{false}" id="" input_id="" class="" title="">
    <div id="{id}" class="krui-ui-slider-field {class}" title="{title}">
        <div class="krui-ui-slider-head">
            <span class="krui-ui-field-lbl">{label}</span>
            <if test="{value_text != ''}"><span class="krui-ui-field-sub">{value_text}</span></if>
        </div>
        <input id="{input_id}" type="range" min="{min}" max="{max}" step="{step}" value="{value}" bind:value="{bind_value}" disabled="{disabled}" oninput="{oninput}" onchange="{onchange}" />
    </div>
</template>

<template name="Chip" variant="assist" label="" leading="" selected="{false}" removable="{false}" disabled="{false}" onclick="" on_remove="" id="" class="" title="">
    <div id="{id}" class="krui-ui-chip krui-ui-chip-{variant} krui-ui-selected-{selected} {class}" title="{title}">
        <button type="button" class="krui-ui-chip-btn" disabled="{disabled}" onclick="{onclick}">
            <slot name="icon"/>
            <if test="{leading != ''}"><span>{leading}</span></if>
            <span>{label}<slot/></span>
        </button>
        <if test="{removable}">
            <button type="button" class="krui-ui-chip-remove" aria-label="제거" disabled="{disabled}" onclick="{on_remove}">
                <svg class="krui-ui-inline-svg" width="16" height="16" viewBox="0 -960 960 960" fill="currentColor"><path d="m249-207-42-42 231-231-231-231 42-42 231 231 231-231 42 42-231 231 231 231-42 42-231-231-231 231Z"/></svg>
            </button>
        </if>
    </div>
</template>

<template name="SelectField" label="" supporting="" value="" bind_value="" onchange="" disabled="{false}" id="" select_id="" class="" title="">
    <div id="{id}" class="krui-ui-select-field {class}" title="{title}">
        <if test="{label != ''}"><label class="krui-ui-field-lbl">{label}</label></if>
        <select id="{select_id}" value="{value}" bind:value="{bind_value}" disabled="{disabled}" onchange="{onchange}"><slot/></select>
        <if test="{supporting != ''}"><span class="krui-ui-field-sub">{supporting}</span></if>
    </div>
</template>

<template name="DatePicker" title="날짜 선택" headline="" month_label="" selected_label="" iso_value="" on_prev_month="" on_next_month="" on_iso_input="" on_confirm="" on_cancel="" confirm_label="적용" cancel_label="취소" id="" class="">
    <section id="{id}" class="krui-ui-picker-card {class}">
        <span class="krui-ui-field-sub">{title}</span>
        <if test="{headline != ''}"><span class="krui-ui-picker-title">{headline}</span></if>
        <div class="krui-ui-picker-head">
            <button type="button" class="krui-ui-btn krui-ui-btn-text krui-ui-picker-step" aria-label="이전 달" onclick="{on_prev_month}">
                <svg class="krui-ui-inline-svg" width="18" height="18" viewBox="0 -960 960 960" fill="currentColor"><path d="M561-240 320-481l241-241 43 43-198 198 198 198-43 43Z"/></svg>
            </button>
            <span class="krui-ui-field-lbl">{month_label}</span>
            <button type="button" class="krui-ui-btn krui-ui-btn-text krui-ui-picker-step" aria-label="다음 달" onclick="{on_next_month}">
                <svg class="krui-ui-inline-svg" width="18" height="18" viewBox="0 -960 960 960" fill="currentColor"><path d="M530-481 332-679l43-43 241 241-241 241-43-43 198-198Z"/></svg>
            </button>
        </div>
        <div class="krui-ui-cal-grid">
            <span class="krui-ui-cal-weekday">일</span>
            <span class="krui-ui-cal-weekday">월</span>
            <span class="krui-ui-cal-weekday">화</span>
            <span class="krui-ui-cal-weekday">수</span>
            <span class="krui-ui-cal-weekday">목</span>
            <span class="krui-ui-cal-weekday">금</span>
            <span class="krui-ui-cal-weekday">토</span>
            <slot/>
        </div>
        <input value="{iso_value}" oninput="{on_iso_input}" placeholder="YYYY-MM-DD" aria-label="ISO 날짜" />
        <if test="{selected_label != ''}"><span class="krui-ui-field-sub">{selected_label}</span></if>
        <div class="krui-ui-picker-head">
            <button type="button" class="krui-ui-btn krui-ui-btn-text" onclick="{on_cancel}">{cancel_label}</button>
            <button type="button" class="krui-ui-btn krui-ui-btn-filled" onclick="{on_confirm}">{confirm_label}</button>
        </div>
    </section>
</template>

<template name="TimePicker" title="시각 선택" hour_text="09" minute_text="30" period_text="AM" is_pm="{false}" is_24h="{false}" hm_value="" on_hour_inc="" on_hour_dec="" on_min_inc="" on_min_dec="" on_set_am="" on_set_pm="" on_toggle_mode="" on_hm_input="" id="" class="">
    <section id="{id}" class="krui-ui-picker-card {class}">
        <div class="krui-ui-picker-head">
            <span class="krui-ui-picker-title">{title}</span>
            <button type="button" class="krui-ui-btn krui-ui-btn-tonal" onclick="{on_toggle_mode}">24H/12H</button>
        </div>
        <div class="krui-ui-time-readout">
            <div class="krui-ui-time-box">
                <button type="button" class="krui-ui-btn krui-ui-btn-text krui-ui-picker-step" aria-label="시 증가" onclick="{on_hour_inc}">
                    <svg class="krui-ui-inline-svg" width="18" height="18" viewBox="0 -960 960 960" fill="currentColor"><path d="M480-554 283-357l-43-43 240-240 240 240-43 43-197-197Z"/></svg>
                </button>
                <span class="krui-ui-time-digits">{hour_text}</span>
                <button type="button" class="krui-ui-btn krui-ui-btn-text krui-ui-picker-step" aria-label="시 감소" onclick="{on_hour_dec}">
                    <svg class="krui-ui-inline-svg" width="18" height="18" viewBox="0 -960 960 960" fill="currentColor"><path d="M480-344 240-584l43-43 197 197 197-197 43 43-240 240Z"/></svg>
                </button>
            </div>
            <span class="krui-ui-time-digits">:</span>
            <div class="krui-ui-time-box">
                <button type="button" class="krui-ui-btn krui-ui-btn-text krui-ui-picker-step" aria-label="분 증가" onclick="{on_min_inc}">
                    <svg class="krui-ui-inline-svg" width="18" height="18" viewBox="0 -960 960 960" fill="currentColor"><path d="M480-554 283-357l-43-43 240-240 240 240-43 43-197-197Z"/></svg>
                </button>
                <span class="krui-ui-time-digits">{minute_text}</span>
                <button type="button" class="krui-ui-btn krui-ui-btn-text krui-ui-picker-step" aria-label="분 감소" onclick="{on_min_dec}">
                    <svg class="krui-ui-inline-svg" width="18" height="18" viewBox="0 -960 960 960" fill="currentColor"><path d="M480-344 240-584l43-43 197 197 197-197 43 43-240 240Z"/></svg>
                </button>
            </div>
            <if test="{!is_24h}">
                <div class="krui-ui-check-labels">
                    <button type="button" class="krui-ui-seg-item krui-ui-selected-{!is_pm}" onclick="{on_set_am}">AM</button>
                    <button type="button" class="krui-ui-seg-item krui-ui-selected-{is_pm}" onclick="{on_set_pm}">PM</button>
                </div>
            </if>
        </div>
        <input value="{hm_value}" oninput="{on_hm_input}" placeholder="HH:MM" aria-label="시각 직접 입력" />
        <slot/>
    </section>
</template>
