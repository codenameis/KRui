<style>
.krui-ui-textfield {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-width: 0px;
    gap: 5px;
}
.krui-ui-textfield-label {
    font-size: 12px;
    font-weight: 600;
    color: var(--krui-text-secondary);
}
.krui-ui-textfield-box {
    display: flex;
    flex-direction: row;
    align-items: center;
    width: 100%;
    min-width: 0px;
    gap: 8px;
    padding: 4px 10px;
    border-radius: var(--krui-input-radius);
    background-color: var(--krui-input-bg);
    border: 1px solid var(--krui-input-border);
}
.krui-ui-textfield-filled {
    border-color: transparent;
    border-bottom: 2px solid var(--krui-input-bottom-border);
}
.krui-ui-textfield-outlined {
    background-color: transparent;
    border: 1px solid var(--krui-input-border);
}
.krui-ui-textfield-input {
    flex-grow: 1;
    min-width: 0px;
    border: 0px solid transparent;
    border-bottom: 0px solid transparent;
    background-color: transparent;
    padding: 4px 2px;
    color: var(--krui-text);
}
.krui-ui-textfield-input:hover {
    background-color: transparent;
    border: 0px solid transparent;
    border-bottom: 0px solid transparent;
}
.krui-ui-textfield-input:focus {
    background-color: transparent;
    border: 0px solid transparent;
    border-bottom: 0px solid transparent;
}
.krui-ui-textfield-foot {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    gap: 8px;
}
.krui-ui-textfield-help {
    font-size: 11px;
    color: var(--krui-text-muted);
}
.krui-ui-textfield-err {
    font-size: 11px;
    color: var(--krui-badge-bg);
    font-weight: 600;
}

.krui-ui-searchbar {
    display: flex;
    flex-direction: row;
    align-items: center;
    width: 100%;
    min-width: 0px;
    gap: 8px;
    padding: 6px 14px;
    border-radius: var(--krui-pill-radius);
    background-color: var(--krui-item-bg);
    border: 0px solid transparent;
    transition: background-color 180ms cubic-bezier(0.2, 0, 0, 1), box-shadow 200ms cubic-bezier(0.2, 0, 0, 1);
}
.krui-ui-searchbar-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    color: var(--krui-text-secondary);
}
.krui-ui-searchbar-svg {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: var(--krui-text-secondary);
}
.krui-ui-searchview {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-width: 0px;
    z-index: 95;
    gap: 6px;
    padding: 12px;
    border-radius: var(--krui-dialog-radius);
    background-color: var(--krui-card);
    border: 0px solid transparent;
    box-shadow: var(--krui-shadow);
    backdrop-filter: blur(var(--krui-backdrop-blur));
}
.krui-ui-searchview-title {
    font-size: 12px;
    font-weight: 700;
    color: var(--krui-heading-color);
}
</style>

<template name="TextField" variant="filled" label="" supporting="" error="" counter="" input_type="text" placeholder="" value="" bind_value="" oninput="" onchange="" onkeydown="" disabled="{false}" leading="" trailing="" id="" class="" title="">
    <div id="{id}" class="krui-ui-textfield {class}" title="{title}">
        <if test="{label != ''}"><label class="krui-ui-textfield-label">{label}</label></if>
        <div class="krui-ui-textfield-box krui-ui-textfield-{variant}">
            <slot name="icon"/>
            <slot name="leading"/>
            <if test="{leading != ''}"><span class="krui-ui-searchbar-icon">{leading}</span></if>
            <input type="{input_type}" class="krui-ui-textfield-input" placeholder="{placeholder}" value="{value}" bind:value="{bind_value}" disabled="{disabled}" oninput="{oninput}" onchange="{onchange}" onkeydown="{onkeydown}" />
            <if test="{trailing != ''}"><span class="krui-ui-searchbar-icon">{trailing}</span></if>
            <slot name="trailing"/>
        </div>
        <div class="krui-ui-textfield-foot">
            <if test="{error != ''}">
                <span class="krui-ui-textfield-err">{error}</span>
            <else-if test="{supporting != ''}">
                <span class="krui-ui-textfield-help">{supporting}</span>
            </if>
            <if test="{counter != ''}"><span class="krui-ui-textfield-help">{counter}</span></if>
        </div>
    </div>
</template>

<template name="SearchBar" placeholder="검색어를 입력하세요" value="" bind_value="" oninput="" onchange="" onkeydown="" on_clear="" show_clear="{false}" id="" class="" title="">
    <div id="{id}" class="krui-ui-searchbar {class}" title="{title}">
        <slot name="icon">
            <svg class="krui-ui-searchbar-svg" width="20" height="20" viewBox="0 -960 960 960" fill="currentColor"><path d="M796-121 533-384q-30 26-70 40.5T378-329q-108 0-183-75t-75-181q0-106 75-181t182-75q106 0 180.5 75T632-585q0 43-14 83t-42 75l264 262-44 44ZM377-389q81 0 138-57.5T572-585q0-81-57-138.5T377-781q-82 0-139.5 57.5T180-585q0 81 57.5 138.5T377-389Z"/></svg>
        </slot>
        <input type="search" class="krui-ui-textfield-input" placeholder="{placeholder}" value="{value}" bind:value="{bind_value}" oninput="{oninput}" onchange="{onchange}" onkeydown="{onkeydown}" />
        <if test="{show_clear}">
            <button type="button" class="krui-ui-btn krui-ui-btn-text" aria-label="지우기" onclick="{on_clear}">
                <svg class="krui-ui-searchbar-svg" width="18" height="18" viewBox="0 -960 960 960" fill="currentColor"><path d="m249-207-42-42 231-231-231-231 42-42 231 231 231-231 42 42-231 231 231 231-42 42-231-231-231 231Z"/></svg>
            </button>
        </if>
    </div>
</template>

<template name="SearchView" open="{false}" title="추천 검색 결과" id="" class="">
    <if test="{open}">
        <section id="{id}" class="krui-ui-searchview {class}">
            <if test="{title != ''}"><span class="krui-ui-searchview-title">{title}</span></if>
            <slot/>
        </section>
    </if>
</template>
